{
  "seed": 42,
  "repo": "Exploration-Lab/CS-781-Capstone",
  "train_tokens": 810000000,
  "val_tokens": 2000000,
  "tokenizer_chars": 100000000,
  "vocab_size": 32768,
  "validation_fraction": 0.02,
  "mix": {
    "supreme_court": 0.35,
